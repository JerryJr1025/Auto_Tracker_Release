// =========================================
function applyTrackerColor(color = trackerUiColor) {

    trackerUiColor = normalizeTrackerColor(color);
    GM_setValue('trackerUiColor', trackerUiColor);

    const text = trackerBestTextColor(trackerUiColor);
    const toward = text;
    const surface = mixTrackerColor(trackerUiColor, toward, 0.08);
    const surface2 = mixTrackerColor(trackerUiColor, toward, 0.045);
    const header = mixTrackerColor(trackerUiColor, toward, 0.12);
    const border = mixTrackerColor(trackerUiColor, toward, 0.28);
    const muted = mixTrackerColor(text, trackerUiColor, 0.24);
    const success = trackerBestSemanticColor(trackerUiColor, ['#4ade80', '#166534', '#14532d']);
    const warning = trackerBestSemanticColor(trackerUiColor, ['#facc15', '#92400e', '#78350f']);
    const danger = trackerBestSemanticColor(trackerUiColor, ['#f87171', '#991b1b', '#7f1d1d']);

    const overlay = $('tracker-overlay');
    if (overlay) {
        overlay.style.setProperty('--tracker-bg', trackerUiColor);
        overlay.style.setProperty('--tracker-surface', surface);
        overlay.style.setProperty('--tracker-surface-2', surface2);
        overlay.style.setProperty('--tracker-border', border);
        overlay.style.setProperty('--tracker-header', header);
        overlay.style.setProperty('--tracker-text', text);
        overlay.style.setProperty('--tracker-muted', muted);
        overlay.style.setProperty('--tracker-success', success);
        overlay.style.setProperty('--tracker-warning', warning);
        overlay.style.setProperty('--tracker-danger', danger);
        overlay.style.background = trackerUiColor;
        overlay.style.color = text;
        overlay.style.borderColor = border;
        overlay.dataset.textTone = text === '#f8fafc' ? 'bright' : 'dark';
        overlay.classList.toggle('tracker-light', text === '#0b1220');
        overlay.querySelectorAll('.tracker-row span, .tracker-row strong, .tracker-subsection-title, .floating-card-title').forEach(element => {
            if (!element.style.color || ['rgb(255, 255, 255)', '#fff', '#ffffff'].includes(String(element.style.color).toLowerCase())) {
                element.style.color = 'var(--tracker-text)';
            }
        });
    }

    if ($('tracker-ui-color')) $('tracker-ui-color').value = trackerUiColor;
    if ($('tracker-ui-color-value')) $('tracker-ui-color-value').value = trackerUiColor;

}

