        if (!release.updateAvailable || !release.latestVersion) {
            showTrackerNotice(
                'Auto Tracker v' + (controllerVersion || getInstalledTrackerVersion()) + '-r' + Number(controllerRevision || TRACKER_RELEASE_REVISION) + ' is up to date.',
