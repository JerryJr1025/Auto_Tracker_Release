function getTrackerBrowserInfo() {

    const ua = String(navigator.userAgent || '');
    const brands = Array.isArray(navigator.userAgentData?.brands)
        ? navigator.userAgentData.brands.map(item => String(item.brand || '')).join(' ')
        : '';
    const source = (brands + ' ' + ua).toLowerCase();
    let name = 'Unknown Browser';
    if (navigator.brave) name = 'Brave';
    else if (source.includes('zen')) name = 'Zen Browser';
    else if (source.includes('opr/') || source.includes('opera')) name = 'Opera';
    else if (source.includes('edg/')) name = 'Microsoft Edge';
    else if (source.includes('firefox/')) name = 'Mozilla Firefox';
    else if (source.includes('chrome/') || source.includes('chromium')) name = 'Google Chrome';
    return { name, userAgent: ua.slice(0, 500), platform: String(navigator.platform || '').slice(0, 120) };

}

