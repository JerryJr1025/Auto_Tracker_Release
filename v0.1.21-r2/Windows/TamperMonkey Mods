// =========================================
// FUNCTION RESET IDLE TIMER
// Search: resetIdleTimer
// Ver 0.0.5 Alpha || 2026-09-07 || JBallados
// Ver 0.0.10 Alpha || 2026-09-24 || JBallados
// Ver 0.0.12 Alpha || 2026-09-27 || JBallados
// =========================================
function resetIdleTimer() {

    clearTimeout(idleTimer);
    lastActivityAt = Date.now();
    if (!shiftStarted) {
        if (currentStatus !== 'WAITING') setStatus('WAITING');
        return;
    }
    if (currentStatus === 'BREAK' || breakState.onBreak || ['BIO', 'HBIO'].includes(currentStatus) || specialSessionState.activeType) {
        return;
    }
    if (currentStatus === 'IDLE') {
        const activityAt = lastActivityAt;
        setStatus('ACTIVE');
        console.log('Sending active_alert');
        api('POST', '/', { action: 'active_alert', activityAt }, data => {
            if (data?.status) setStatus(data.status);
        });
    }
    const idleStartedAt = lastActivityAt + IDLE_TIMEOUT;
    idleTimer = setTimeout(() => {
        if (currentStatus === 'BREAK' || breakState.onBreak || ['BIO', 'HBIO'].includes(currentStatus) || specialSessionState.activeType) return;
        console.log('Sending idle_alert');
        api('POST', '/', { action: 'idle_alert', idleStartedAt }, data => {
            if (['BREAK', 'BIO', 'HBIO'].includes(data?.status)) {
                if (data?.specialSessionState) applySpecialSessionState(data.specialSessionState);
                setStatus(data.status);
                return;
            }
            setStatus(data?.status || 'IDLE');
        });
    }, IDLE_TIMEOUT);

}

function reconcileDelayedIdleBeforeActivity(activityAt = Date.now()) {

    if (!shiftStarted || currentStatus === 'BREAK' || breakState.onBreak || ['BIO', 'HBIO'].includes(currentStatus) || specialSessionState.activeType) return;
    const thresholdAt = Number(lastActivityAt || activityAt) + IDLE_TIMEOUT;
    if (activityAt < thresholdAt || currentStatus === 'IDLE') return;
    api('POST', '/', { action: 'idle_alert', idleStartedAt: thresholdAt }, idleData => {
        if (!idleData || idleData.status !== 'IDLE') return;
        api('POST', '/', { action: 'active_alert', activityAt }, activeData => {
            if (activeData?.status) setStatus(activeData.status);
        });
    });

}

