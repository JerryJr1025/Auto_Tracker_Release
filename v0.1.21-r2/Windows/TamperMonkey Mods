// FUNCTION INSTALL TRACKER CLIENT ERROR LOGGING
// Search: installTrackerClientErrorLogging
// Ver 0.1.16 Alpha || 2026-09-28 || JBallados || Error_Logging
// =========================================
function installTrackerClientErrorLogging() {

    if (trackerErrorLoggingInstalled) return;
    trackerErrorLoggingInstalled = true;
    window.addEventListener('error', event => {
        reportTrackerClientError('window.error', event.error || new Error(String(event.message || 'Window error')));
    });
    window.addEventListener('unhandledrejection', event => {
        const reason = event.reason instanceof Error ? event.reason : new Error(String(event.reason || 'Unhandled promise rejection'));
        reportTrackerClientError('unhandledrejection', reason);
    });

}

