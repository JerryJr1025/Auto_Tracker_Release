function getProspectiveShiftPolicy(timestamp = Date.now()) {
    const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Manila',
        hour: '2-digit',
        hourCycle: 'h23'
    }).formatToParts(new Date(timestamp));
    const hour = Number(parts.find(part => part.type === 'hour')?.value);
    const dayShift = Number.isFinite(hour) && hour >= 8 && hour <= 11;
    const rawDepartment = String(
        $('tracker-upload-department')?.value
        || reportUploadSettingsState.department
        || shiftSchedule?.department
        || 'OOS'
    ).trim().toUpperCase();
    const department = rawDepartment === 'CWH' ? 'OOS' : rawDepartment;

    if (department === 'ENCORD') {
        return {
            department,
            dayShift,
            workMinutes: 480,
            breakMinutes: 30,
            lunchMinutes: 60,
            intervalCount: 2,
            pauseSummary: '30m Break + 60m Lunch',
            regularWindowMinutes: 570
        };
    }

    const breakMinutes = dayShift ? 0 : 30;
    const lunchMinutes = dayShift ? 60 : 0;
    return {
        department: 'OOS',
        dayShift,
        workMinutes: 360,
        breakMinutes,
        lunchMinutes,
        intervalCount: 3,
        pauseSummary: dayShift ? '60m Lunch' : '30m Break',
        regularWindowMinutes: 360 + breakMinutes + lunchMinutes
    };
}

function formatShiftMinutes(minutes) {
    const safe = Math.max(0, Number(minutes || 0));
    const hours = Math.floor(safe / 60);
    const mins = safe % 60;
    return hours > 0 ? (hours + 'h' + (mins ? ' ' + mins + 'm' : '')) : (mins + 'm');
}

