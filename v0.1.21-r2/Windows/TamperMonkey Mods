// =========================================
function api(method, endpoint, data, callback) {

    const traceId = createTrackerTraceId('REQ');
    const startedAt = Date.now();
    const safeLogData = sanitizeTrackerLogObject(data);
    console.log('🌐 API REQUEST [' + traceId + ']:', method, endpoint, safeLogData);
    GM_xmlhttpRequest({
        method,
        url: SERVER + endpoint,
        headers: {
            'Content-Type': 'application/json',
            'X-Tracker-Trace-Id': traceId
        },
        data: data ? JSON.stringify(data) : undefined,
        timeout: 15000,
        onload(res) {
            const responsePreview = redactTrackerLogValue(res.responseText || '', 1600);
            const durationMs = Math.max(0, Date.now() - startedAt);
            console.log('📥 API RESPONSE [' + traceId + ']:', res.status, durationMs + 'ms', responsePreview);
            let parsed = null;
            try {
                parsed = JSON.parse(res.responseText);
                setControllerConnection(true, parsed);
            } catch (error) {
                reportTrackerClientError('api.json_parse', error, {
                    errorCode: 'ERR-FRONTEND-API-JSON',
                    severity: 'ERROR',
                    traceId,
                    method,
                    endpoint,
                    httpStatus: res.status,
                    durationMs,
                    responsePreview
                });
                if (callback) callback(null);
                return;
            }
            if (Number(res.status) >= 400) {
                const httpError = new Error(
                    String(parsed?.message || parsed?.error || ('Controller returned HTTP ' + res.status))
                );
                reportTrackerClientError('api.http_error', httpError, {
                    errorCode: Number(res.status) >= 500 ? 'ERR-FRONTEND-API-5XX' : 'ERR-FRONTEND-API-4XX',
                    severity: Number(res.status) >= 500 ? 'ERROR' : 'WARN',
                    traceId,
                    method,
                    endpoint,
                    httpStatus: res.status,
                    durationMs,
                    responsePreview
                });
            }
            if (callback) callback(parsed);
        },
        onerror(error) {
            controllerConnected = false;
            renderControllerIdentity();
            renderShiftWall();
            const requestError = new Error(
                'Request failed: ' + redactTrackerLogValue(error?.error || error?.message || 'network error', 500)
            );
            console.error('❌ API REQUEST ERROR [' + traceId + ']:', error);
            reportTrackerClientError('api.network_error', requestError, {
                errorCode: 'ERR-FRONTEND-API-NETWORK',
                severity: 'ERROR',
                traceId,
                method,
                endpoint,
                durationMs: Math.max(0, Date.now() - startedAt)
            });
            if (callback) callback(null);
        },
        ontimeout() {
            controllerConnected = false;
            renderControllerIdentity();
            renderShiftWall();
            console.error('❌ API REQUEST TIMEOUT [' + traceId + ']');
            reportTrackerClientError('api.timeout', new Error('Controller request timed out after 15 seconds.'), {
                errorCode: 'ERR-FRONTEND-API-TIMEOUT',
                severity: 'WARN',
                traceId,
                method,
                endpoint,
                durationMs: Math.max(0, Date.now() - startedAt)
            });
            if (callback) callback(null);
        }
    });

}

// =========================================
// FUNCTION REPORT TRACKER CLIENT ERROR
// Search: reportTrackerClientError
// Ver 0.1.16 Alpha || 2026-09-28 || JBallados || Error_Logging
// =========================================
function reportTrackerClientError(eventType, error, context = {}) {

    try {
        const message = error instanceof Error ? error.message : String(error || 'Unknown tracker error');
        const stack = error instanceof Error && error.stack ? String(error.stack) : '';
        const safeContext = sanitizeTrackerLogObject(context || {});
        const traceId = String(safeContext.traceId || createTrackerTraceId('FE')).slice(0, 120);
        GM_xmlhttpRequest({
            method: 'POST',
            url: SERVER + '/',
            headers: {
                'Content-Type': 'application/json',
                'X-Tracker-Trace-Id': traceId
            },
            data: JSON.stringify({
                action: 'client_error',
                eventType: String(eventType || 'client-error').slice(0, 80),
                errorName: error instanceof Error ? String(error.name || 'Error').slice(0, 120) : 'Error',
                errorCode: String(safeContext.errorCode || 'ERR-FRONTEND-CLIENT').slice(0, 96),
                severity: String(safeContext.severity || 'ERROR').slice(0, 16),
                traceId,
                message: redactTrackerLogValue(message, 3000),
                stack: redactTrackerLogValue(stack, 10000),
                page: location.origin + location.pathname,
                trackerVersion: GM_info?.script?.version || 'unknown',
                controllerVersion: controllerVersion || 'disconnected',
                browser: getTrackerBrowserInfo().name,
                trackerStatus: currentStatus,
                trackingMode,
                shiftStarted,
                currentJobId: lastJobId || '',
                method: String(safeContext.method || '').slice(0, 20),
                endpoint: String(safeContext.endpoint || '').slice(0, 500),
                httpStatus: Number(safeContext.httpStatus || 0) || null,
                durationMs: Number(safeContext.durationMs || 0) || null,
                responsePreview: redactTrackerLogValue(safeContext.responsePreview || '', 1200)
            }),
            timeout: 5000
        });
        return traceId;
    } catch {
        return null;
    }

}

