function handleSkip(event) {

    if (!event.isTrusted) return;
    const target = event.target instanceof Element ? event.target.closest('button, [role="button"], input[type="button"]') : null;
    if (!target || target.disabled || target.getAttribute('aria-disabled') === 'true' || target.closest('#tracker-overlay')) return;
    const labels = [target.innerText, target.textContent, target.getAttribute('aria-label'), target.value, target.dataset?.action];
    if (!labels.some(value => /^(skip|skip task)$/i.test(String(value || '').trim()))) return;
    if (!shiftStarted) {
        event.preventDefault();
        event.stopImmediatePropagation();
        showTrackerNotice('START SHIFT REQUIRED. Work was blocked so the tracker does not miss this task.', 10000);
        renderShiftWall();
        console.warn('Skip blocked because Start Shift has not been clicked.');
        return;
    }
    const decision = modeMismatchDecision();
    if (decision === 'block') {
        event.preventDefault();
        event.stopImmediatePropagation();
        log('⚠ Switch tracker to Coverage before continuing');
        return;
    }
    if (decision === 'bypass' || trackingMode !== 2) {
        console.warn('Skip continued without tracker counting because the page and tracker modes do not match.');
        return;
    }
    const now = Date.now();
    const taskData = getCurrentTaskPosition();
    const jobId = getJobId();
    const skipKey = taskData ? `${jobId}:${taskData.position}/${taskData.total}` : `${jobId}:unknown`;
    const sameTaskRecentlyHandled = skipKey === lastHandledSkipKey && now - lastHandledSkipTime < 1500;
    if (pendingSkipKeys.has(skipKey) || sameTaskRecentlyHandled) {
        event.preventDefault();
        event.stopImmediatePropagation();
        console.warn('⏳ Duplicate Skip for the same task was blocked.');
        return;
    }
    lastHandledSkipTime = now;
    lastHandledSkipKey = skipKey;
    pendingSkipKeys.add(skipKey);
    setTimeout(() => pendingSkipKeys.delete(skipKey), 3000);
    resetIdleTimer();
    api('POST', '/', {
        action: 'coverage_skip',
        pageMode: detectExpectedTrackingMode(),
        requestId: createRequestId(),
        jobId,
        submittedTaskPosition: taskData?.position ?? null,
        totalTasks: taskData?.total ?? 0,
        isJobFinished: Boolean(taskData && taskData.total > 0 && taskData.position >= taskData.total)
    }, data => {
        pendingSkipKeys.delete(skipKey);
        if (data?.error === 'TRACKING_MODE_MISMATCH') refreshModeMismatchWarning();
        if (data) updateStats(data);
    });

}

