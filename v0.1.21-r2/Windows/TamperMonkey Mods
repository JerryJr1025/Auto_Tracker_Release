    const target = event.target instanceof Element ? event.target.closest('button, [role="button"], input[type="submit"]') : null;
    if (!target || target.disabled || target.getAttribute('aria-disabled') === 'true') return;
    const isSubmit = isSubmitTarget(target);
    if (!isSubmit || target.closest('#tracker-overlay')) return;
    if (!shiftStarted) {
        event.preventDefault();
        event.stopImmediatePropagation();
        showTrackerNotice('START SHIFT REQUIRED. Work was blocked so the tracker does not miss this task.', 10000);
        renderShiftWall();
        console.warn('Submit blocked because Start Shift has not been clicked.');
        return;
    }
    const decision = modeMismatchDecision();
    if (decision === 'block') {
        event.preventDefault();
        event.stopImmediatePropagation();
        log('⚠ Switch tracker to Coverage before submitting');
        return;
    }
    if (decision === 'bypass') {
        console.warn('Submit continued without tracker counting because the page and tracker modes do not match.');
        return;
    }
    console.log('🎯 VALID SUBMIT CLICK:', target.tagName, target.innerText?.trim());
    const now = Date.now();
    if (now - lastHandledSubmitTime < SUBMIT_DEBOUNCE_MS || submitLocked || submitRequestInProgress) {
        event.preventDefault();
        event.stopImmediatePropagation();
        console.warn('⏳ Duplicate Submit click blocked until the current task changes.');
        return;
    }
    const coverageMetrics = trackingMode === 2 ? getCoverageMetrics() : null;
    if (trackingMode === 2 && !coverageMetrics) {
        event.preventDefault();
        event.stopImmediatePropagation();
        log('⚠ Coverage submit blocked: unable to read the four Coverage counters.');
        console.warn('Coverage snapshot missing; Submit blocked to protect tracker accuracy.');
        return;
    }
    submitLocked = true;
    submitRequestInProgress = true;
    lastHandledSubmitTime = now;
    const previousTaskSnapshot = getSubmitTaskSnapshot();
    const previousTaskData = getCurrentTaskPosition();
    const previousTaskPosition = previousTaskData ? previousTaskData.position : null;
    const previousTotalTasks = previousTaskData ? previousTaskData.total : null;
    resetIdleTimer();
    const jobId = getJobId();
    let isJobFinished = false;
    const currentTaskData = getCurrentTaskPosition();
    if (currentTaskData) {
        const current = currentTaskData.position;
        const total = currentTaskData.total;
        isJobFinished = Number.isFinite(current) && Number.isFinite(total) && total > 0 && current >= total;
    }
    const requestId = createRequestId();
    api('POST', '/', {
        action: 'click_submit',
        pageMode: detectExpectedTrackingMode(),
        coverageMetrics,
        requestId,
        jobId,
        isJobFinished,
        intervalNumber: currentIntervalNumber,
        submittedTaskPosition: previousTaskPosition,
        submittedTaskSnapshot: previousTaskSnapshot,
        totalTasks: previousTotalTasks || 0
    }, data => {
        if (!data || data.success === false || data.error) {
            submitRequestInProgress = false;
            submitLocked = false;
            if (data?.error === 'TRACKING_MODE_MISMATCH') refreshModeMismatchWarning();
            console.warn('⚠️ Submit received no accepted response.', data);
            return;
        }
        if (typeof data.allTimeTasks === 'number') localCounters.totalTaskCompleted = data.allTimeTasks;
        if (typeof data.totalTaskCompleted === 'number') localCounters.totalTaskCompleted = data.totalTaskCompleted;
        if (typeof data.totalJobsCompleted === 'number') localCounters.totalJobsCompleted = data.totalJobsCompleted;
        updateStats(data);
        log(`✅ Task submitted ${isJobFinished ? '(Job Complete)' : ''}`);
        if (previousTaskPosition !== null) {
            waitForTaskChange(previousTaskPosition);
        } else {
            setTimeout(() => {
                submitLocked = false;
                submitRequestInProgress = false;
            }, 5000);
        }
    });

}

