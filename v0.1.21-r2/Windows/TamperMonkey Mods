// =========================================
// FUNCTION MAKE DRAGGABLE
// Search: makeDraggable
// Ver 0.0.5 Alpha || 2026-09-07 || JBallados
// =========================================
function makeDraggable(element, handle, collapsedHandle = null) {

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;
    let activeHandle = null;
    const dragHandles = [handle || element, collapsedHandle].filter(Boolean);
    dragHandles.forEach(dragHandle => dragHandle.addEventListener('pointerdown', startDrag));

    function startDrag(e) {
        if (trackerLayoutMode !== 'floating' || e.button !== 0) return;
        const fromCollapsedHandle = collapsedHandle && (e.currentTarget === collapsedHandle || collapsedHandle.contains(e.target));
        if (trackerCollapsed && !fromCollapsedHandle) return;
        if (!trackerCollapsed && e.target instanceof Element && e.target.closest('button')) return;
        isDragging = true;
        activeHandle = e.currentTarget;
        startX = e.clientX;
        startY = e.clientY;
        startLeft = element.offsetLeft;
        startTop = element.offsetTop;
        if (activeHandle?.setPointerCapture) activeHandle.setPointerCapture(e.pointerId);
        document.addEventListener('pointermove', drag);
        document.addEventListener('pointerup', stopDrag);
        e.preventDefault();
    }

    function drag(e) {
        if (!isDragging) return;
        const maxLeft = Math.max(0, window.innerWidth - element.offsetWidth);
        const maxTop = Math.max(0, window.innerHeight - element.offsetHeight);
        trackerFloatLeft = Math.min(Math.max(0, startLeft + (e.clientX - startX)), maxLeft);
        trackerFloatTop = Math.min(Math.max(0, startTop + (e.clientY - startY)), maxTop);
        element.style.left = trackerFloatLeft + 'px';
        element.style.top = trackerFloatTop + 'px';
    }

    function stopDrag(e) {
        if (!isDragging) return;
        isDragging = false;
        GM_setValue('trackerFloatLeft', trackerFloatLeft);
        GM_setValue('trackerFloatTop', trackerFloatTop);
        try { if (activeHandle?.releasePointerCapture) activeHandle.releasePointerCapture(e.pointerId); } catch {}
        activeHandle = null;
        document.removeEventListener('pointermove', drag);
        document.removeEventListener('pointerup', stopDrag);
    }

}

