function renderUpdateInstallControls() {
    const installButton = $('tracker-install-release-btn');
    const restartButton = $('tracker-restart-controller-btn');
    const status = $('tracker-update-install-status');

    const integrityWarning = Boolean(latestReleaseState?.integrityWarning);
    const updateAvailable = Boolean(latestReleaseState?.updateAvailable && latestReleaseState?.latestVersion);
    const staged = updateInstallState?.state === 'STAGED' && updateInstallState?.restartRequired;

    if (installButton) {
        installButton.disabled = integrityWarning || staged;
        installButton.textContent = integrityWarning
            ? 'Update Blocked — Checksum Warning'
            : staged
                ? 'Update Files Installed'
                : updateAvailable
                    ? 'Install v' + latestReleaseState.latestVersion + '-r' + Number(latestReleaseState.latestRevision || 0)
                    : 'Check & Install Auto Tracker Update';
    }
    if (restartButton) restartButton.style.display = staged ? 'block' : 'none';
    if (status) {
        status.textContent = integrityWarning
            ? 'Update install: blocked because Drive release checksums changed.'
            : staged
                ? 'Update install: v' + updateInstallState.version + '-r' + Number(updateInstallState.revision || 0) + ' staged. Approve Tampermonkey, then restart.'
                : updateInstallState?.state === 'FAILED'
                    ? 'Update install: failed (' + String(updateInstallState.error || 'unknown') + ').'
                    : updateAvailable
                        ? 'Update install: v' + latestReleaseState.latestVersion + '-r' + Number(latestReleaseState.latestRevision || 0) + ' is ready to install.'
                        : 'Update install: no pending installation.';
    }
}

function renderControllerIdentity() {
    const browser = getTrackerBrowserInfo().name;
    const tmVersion = getInstalledTrackerVersion();
    const tmRevision = getInstalledTrackerRevision();
    const ctrl = controllerConnected && controllerVersion
        ? 'v' + controllerVersion + '-r' + Number(controllerRevision || 0)
        : 'DISCONNECTED';
    const mismatch = Boolean(
        controllerConnected
        && controllerVersion
        && tmVersion !== 'unknown'
        && (
            String(controllerVersion) !== String(tmVersion)
            || Number(controllerRevision || 0) !== Number(tmRevision || 0)
        )
    );
    const updateAvailable = Boolean(latestReleaseState?.updateAvailable && latestReleaseState?.latestVersion);
    const integrityWarning = Boolean(latestReleaseState?.integrityWarning);
    const updateLabel = updateAvailable
        ? ' | UPDATE v' + latestReleaseState.latestVersion + '-r' + Number(latestReleaseState.latestRevision || 0)
        : integrityWarning ? ' | ⚠ RELEASE CHANGED' : '';
    const status = $('tracker-version-status');
    if (status) {
        status.textContent = 'CTRL ' + ctrl + ' | TM v' + tmVersion + '-r' + tmRevision
            + (mismatch ? ' ⚠ MISMATCH' : '')
            + updateLabel;
        status.style.color = mismatch || updateAvailable || integrityWarning ? 'var(--tracker-warning)' : 'var(--tracker-muted)';
    }
    const diag = $('tracker-runtime-status');
    if (diag) {
        diag.textContent = 'Controller: ' + ctrl + ' • Tampermonkey: v' + tmVersion + '-r' + tmRevision + ' • Browser: ' + browser
            + (mismatch ? ' • Version/revision mismatch' : '')
            + (updateAvailable ? ' • New: v' + latestReleaseState.latestVersion + '-r' + Number(latestReleaseState.latestRevision || 0) : '')
            + (integrityWarning ? ' • Release checksum warning' : '');
    }
    renderUpdateInstallControls();
}

function setControllerConnection(connected, data = null) {
