            + '\n\nAfter the userscript opens, approve the Tampermonkey update, then click "Restart Controller to Finish".'
        );
        if (!confirmed) return;

        let installerWindow = null;
        try {
            installerWindow = window.open('about:blank', '_blank');
            if (installerWindow) installerWindow.document.title = 'Auto Tracker Update';
        } catch {}

        showTrackerNotice('Downloading and verifying Auto Tracker update...', 15000);
        api('POST', '/', { action:'install_release' }, result => {
            if (!result || result.success === false) {
                try { if (installerWindow && !installerWindow.closed) installerWindow.close(); } catch {}
                const message = result?.message || result?.error || 'Update installation failed.';
                showTrackerNotice('Update failed: ' + message, 16000);
                log('⚠ Update failed: ' + message);
                if (result?.updateInstall) updateInstallState = { ...updateInstallState, ...result.updateInstall };
                renderUpdateInstallControls();
                return;
            }

            if (result.updateInstall) updateInstallState = { ...updateInstallState, ...result.updateInstall };
            else updateInstallState = {
                state:'STAGED',
                version:result.version || release.latestVersion,
                revision:Number(result.revision ?? release.latestRevision ?? 0),
                restartRequired:Boolean(result.restartRequired)
            };

            const applyUrl = String(result.applyUrl || (SERVER + '/tampermonkey.user.js'));
            try {
                if (installerWindow && !installerWindow.closed) {
                    installerWindow.location.href = applyUrl;
                } else {
                    const opened = window.open(applyUrl, '_blank');
                    if (!opened) showTrackerNotice('Update files are installed. Open ' + applyUrl + ' to approve the Tampermonkey update.', 18000);
                }
            } catch {
                showTrackerNotice('Update files are installed. Open the Tampermonkey updater from System Status if the install page did not open.', 18000);
            }

            renderUpdateInstallControls();
            showTrackerNotice(
                'Update files verified and installed. Approve the Tampermonkey update, then click "Restart Controller to Finish".',
                18000
            );
            log('Update staged: v' + String(result.version || release.latestVersion) + '-r' + Number(result.revision ?? release.latestRevision ?? 0));
        });
    });
}

