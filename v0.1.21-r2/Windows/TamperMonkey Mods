function normalizePauseState(raw, fallback = {}) {
    const kind = String(raw?.kind || fallback.kind || 'BREAK').toUpperCase() === 'LUNCH' ? 'LUNCH' : 'BREAK';
    const totalSeconds = Math.max(0, Number(raw?.totalSeconds ?? fallback.totalSeconds ?? (kind === 'LUNCH' ? 3600 : 1800)));
    return {
        onBreak: Boolean(raw?.onBreak),
        anyPauseActive: Boolean(raw?.anyPauseActive),
        totalSeconds,
        usedSeconds: Math.max(0, Number(raw?.usedSeconds ?? fallback.usedSeconds ?? 0)),
        remainingSeconds: Math.max(0, Number(raw?.remainingSeconds ?? fallback.remainingSeconds ?? totalSeconds)),
        available: raw?.available !== undefined ? Boolean(raw.available) : Number(raw?.remainingSeconds ?? totalSeconds) > 0,
        expired: raw?.expired !== undefined ? Boolean(raw.expired) : Number(raw?.remainingSeconds ?? totalSeconds) <= 0,
        supported: raw?.supported !== undefined ? Boolean(raw.supported) : true,
        allowanceMinutes: Math.max(0, Number(raw?.allowanceMinutes ?? fallback.allowanceMinutes ?? Math.round(totalSeconds / 60))),
        kind,
        label: String(raw?.label || fallback.label || (kind === 'LUNCH' ? 'Lunch Break' : 'Break')),
        activeKind: raw && Object.prototype.hasOwnProperty.call(raw, 'activeKind') ? raw.activeKind : (fallback.activeKind || null),
        availableKinds: Array.isArray(raw?.availableKinds) ? [...raw.availableKinds] : (Array.isArray(fallback.availableKinds) ? [...fallback.availableKinds] : [kind]),
        department: String(raw?.department || fallback.department || shiftSchedule?.department || reportUploadSettingsState.department || 'OOS').toUpperCase()
    };
}

function applyBreakState(raw) {

    if (!raw) return;
    breakState = normalizePauseState(raw, breakState);
    breakCountdownAnchorAt = Date.now();
    breakCountdownAnchorRemainingSeconds = breakState.remainingSeconds;
    updateBreakControl();
    renderBreakCountdown();

}

function applyPauseStates(raw) {
    if (!raw) return;
    pauseStates = {
        break: normalizePauseState(raw.break || {}, pauseStates.break),
        lunch: normalizePauseState(raw.lunch || {}, pauseStates.lunch)
    };
    const active = pauseStates.break.onBreak ? pauseStates.break : pauseStates.lunch.onBreak ? pauseStates.lunch : null;
    if (active) {
        breakState = { ...active };
        breakCountdownAnchorAt = Date.now();
        breakCountdownAnchorRemainingSeconds = breakState.remainingSeconds;
    } else {
        const preferredKind = String(breakState.kind || '').toUpperCase() === 'LUNCH' ? 'lunch' : 'break';
        const neutral = pauseStates[preferredKind] || pauseStates.break || pauseStates.lunch || breakState;
        breakState = {
            ...neutral,
            onBreak: false,
            anyPauseActive: false,
            activeKind: null
