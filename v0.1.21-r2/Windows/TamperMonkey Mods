        }, data => {
            if (!data || data.success === false) {
                try { updateTab.close(); } catch {}
                showTrackerNotice('Tampermonkey update rejected: ' + (data?.message || data?.error || 'Invalid userscript.'), 15000);
                log('Tampermonkey update rejected');
                return;
            }

            if (data.status === 'CURRENT' && !data.updateAvailable) {
                try { updateTab.close(); } catch {}
                showTrackerNotice('Selected TamperMonkey Mods is already current. No overwrite was needed.', 12000);
                log('Tampermonkey source is current');
                return;
            }

