function renderShiftWall() {
    const wall = ensureShiftWall();
    if (!wall) return;
    wall.style.display = shiftStarted ? 'none' : 'flex';
    if (shiftStarted) return;
    const status = $('shift-wall-status');
    const start = $('shift-wall-start');
    const scheduleNote = $('shift-wall-schedule-note');
    const prospective = getProspectiveShiftPolicy();
    if (scheduleNote) {
        scheduleNote.textContent = prospective.department + ' • Expected regular window: ' + formatShiftMinutes(prospective.regularWindowMinutes)
            + ' • ' + prospective.pauseSummary
            + ' • ' + prospective.intervalCount + ' regular interval' + (prospective.intervalCount === 1 ? '' : 's')
            + '. Overtime begins after the regular window.';
    }
    if (!controllerConnected) {
        if (status) status.textContent = 'Controller disconnected. Start Shift cannot be confirmed until the local controller reconnects.';
        if (start) start.disabled = true;
        return;
    }
    const hasMode = trackingMode === 1 || trackingMode === 2;
    if (status) status.textContent = hasMode
        ? 'Auto Tracker is paused. Click START SHIFT before beginning work so Tasks, Jobs, Active/Idle, Break, intervals and Overtime are recorded.'
        : 'Select Confirmation or Coverage, then click START SHIFT before beginning work.';
    if (start) start.disabled = !hasMode;
    $('shift-wall-mode1')?.classList.toggle('active', trackingMode === 1);
    $('shift-wall-mode2')?.classList.toggle('active', trackingMode === 2);
}

