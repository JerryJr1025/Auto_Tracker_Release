// =========================================
function applyDockLayout() {

    const overlay = $('tracker-overlay');
    if (!overlay) return;
    const root = getToolRoot();
    const floating = trackerLayoutMode === 'floating';
    if (floating) overlay.classList.remove('tracker-settings-open');
    overlay.classList.toggle('tracker-floating', floating);
    overlay.classList.toggle('tracker-collapsed', trackerCollapsed);

    if ($('tracker-collapse-btn')) {
        $('tracker-collapse-btn').textContent = '−';
        $('tracker-collapse-btn').title = 'Minimize tracker';
    }
    if ($('tracker-expand-middle')) {
        $('tracker-expand-middle').textContent = floating ? '+' : (trackerLayoutMode === 'left' ? '▶' : '◀');
        $('tracker-expand-middle').title = floating ? 'Expand tracker' : 'Maximize tracker';
    }

    if (floating) {
        const floatingWidth = trackerCollapsed ? TRACKER_FLOAT_COMPACT_WIDTH : TRACKER_FLOAT_WIDTH;
        const floatingHeight = trackerCollapsed ? TRACKER_FLOAT_COMPACT_HEIGHT : 'auto';
        const maxLeft = Math.max(0, window.innerWidth - floatingWidth - 6);
        const maxTop = Math.max(0, window.innerHeight - (trackerCollapsed ? TRACKER_FLOAT_COMPACT_HEIGHT : 260));
        trackerFloatLeft = Math.min(Math.max(6, trackerFloatLeft), maxLeft);
        trackerFloatTop = Math.min(Math.max(6, trackerFloatTop), maxTop);
        overlay.style.width = floatingWidth + 'px';
        overlay.style.height = typeof floatingHeight === 'number' ? floatingHeight + 'px' : floatingHeight;
        overlay.style.maxHeight = trackerCollapsed ? TRACKER_FLOAT_COMPACT_HEIGHT + 'px' : 'calc(100vh - 12px)';
        overlay.style.left = trackerFloatLeft + 'px';
        overlay.style.top = trackerFloatTop + 'px';
        overlay.style.right = 'auto';
        overlay.style.bottom = 'auto';
        overlay.style.borderRadius = trackerCollapsed ? '12px' : '14px';
        overlay.style.overflow = 'hidden';
        if ($('tracker-layout-label')) $('tracker-layout-label').textContent = 'FLOAT';
        if (root) {
            root.style.removeProperty('width');
            root.style.removeProperty('max-width');
            root.style.removeProperty('margin-left');
            root.style.removeProperty('margin-right');
        }
        document.body.style.removeProperty('padding-left');
        document.body.style.removeProperty('padding-right');
    } else {
        const side = trackerLayoutMode === 'left' ? 'left' : 'right';
        const width = trackerCollapsed ? TRACKER_COLLAPSED_WIDTH : TRACKER_DOCK_WIDTH;
        GM_setValue('trackerDockSide', side);
        overlay.style.width = width + 'px';
        overlay.style.height = '100vh';
        overlay.style.maxHeight = 'none';
        overlay.style.top = '0';
        overlay.style.bottom = '0';
        overlay.style.left = side === 'left' ? '0' : 'auto';
        overlay.style.right = side === 'right' ? '0' : 'auto';
        overlay.style.borderRadius = '0';
        if ($('tracker-layout-label')) $('tracker-layout-label').textContent = side === 'left' ? 'LEFT' : 'RIGHT';
        if (root) {
            root.style.setProperty('box-sizing', 'border-box', 'important');
            root.style.setProperty('width', `calc(100vw - ${width}px)`, 'important');
            root.style.setProperty('max-width', `calc(100vw - ${width}px)`, 'important');
            root.style.setProperty('margin-left', side === 'left' ? width + 'px' : '0px', 'important');
            root.style.setProperty('margin-right', side === 'right' ? width + 'px' : '0px', 'important');
        } else {
            document.body.style.setProperty('box-sizing', 'border-box', 'important');
            document.body.style.setProperty('padding-left', side === 'left' ? width + 'px' : '0px', 'important');
            document.body.style.setProperty('padding-right', side === 'right' ? width + 'px' : '0px', 'important');
        }
    }

}

