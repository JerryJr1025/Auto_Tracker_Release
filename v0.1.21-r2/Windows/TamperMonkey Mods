function createTrackerTraceId(prefix = 'REQ') {

    const safePrefix = String(prefix || 'REQ').toUpperCase().replace(/[^A-Z0-9_-]/g, '').slice(0, 12) || 'REQ';
    let randomPart = '';
    try {
        const bytes = new Uint8Array(4);
        crypto.getRandomValues(bytes);
        randomPart = Array.from(bytes).map(value => value.toString(16).padStart(2, '0')).join('').toUpperCase();
    } catch {
        randomPart = Math.random().toString(16).slice(2, 10).toUpperCase();
    }
    return safePrefix + '-' + Date.now().toString(36).toUpperCase() + '-' + randomPart;

}

function redactTrackerLogValue(value, maxLength = 1600) {

    let text = String(value ?? '');
    text = text
        .replace(/(Bearer\s+)[A-Za-z0-9._~+\/-]+/gi, '$1[REDACTED]')
        .replace(/((?:registrationToken|deviceToken|teamLeadToken|authorization|password|secret|cookie)\s*["']?\s*[:=]\s*["']?)[^"',}\s]+/gi, '$1[REDACTED]')
        .replace(/\b[a-f0-9]{64}\b/gi, '[REDACTED_TOKEN]');
    return text.slice(0, Math.max(0, Number(maxLength) || 0));

}

function sanitizeTrackerLogObject(value) {

    try {
        return JSON.parse(JSON.stringify(value == null ? {} : value, (key, item) => {
            if (/token|secret|password|authorization|cookie|fileBase64/i.test(key)) return item ? '[REDACTED]' : item;
            if (typeof item === 'string') return redactTrackerLogValue(item, 1600);
            return item;
        }));
    } catch {
        return { loggingError: 'Context could not be serialized safely.' };
    }

}

