function connectEvents() {

    if (eventSource) {
        eventSource.close();
    }
    eventSource = new EventSource(SERVER + "/events");
    eventSource.onopen = () => {
        controllerConnected = true;
        lastControllerSeenAt = Date.now();
        renderControllerIdentity();
        renderShiftWall();
        log("Connected");
    };
    eventSource.onmessage = event => {
        try {
            const data = JSON.parse(event.data);
            updateStats(data);
            if (data.action === 'break_expired') {
                showTrackerNotice(data.message || ((breakState.label || 'Break') + ' is finished. Status is now IDLE.'), 12000);
            }
            if (data.action === 'special_session_expired' || data.action === 'special_session_ended') {
                showTrackerNotice(data.message || 'BIO/HBIO session ended. Work resumed.', 12000);
            }
            if (data.action === "interval_reset") {
                const serverInterval = Number(data.currentInterval?.number);
                console.log("🔄 INTERVAL RESET EVENT RECEIVED:", serverInterval);
                if (Number.isFinite(serverInterval) && serverInterval >= 1) {
                    currentIntervalNumber = serverInterval;
                    if ($("interval")) {
                        $("interval").innerText = getIntervalName(currentIntervalNumber);
                    }
                    log("🔄 Interval changed to " + getIntervalName(currentIntervalNumber));
                    console.log("✅ Interval updated and saved:", currentIntervalNumber);
                } else {
                    console.warn("⚠️ Invalid interval_reset received:", data.currentInterval);
                }
                lastHandledSkipTime = 0;
                lastHandledSkipKey = '';
                pendingSkipKeys.clear();
                initializeLocalCountersFromStats(data);
                return;
            }
            if (data.action === "reset_counters") {
                log("🔄 Counters Reset");
                resetLocalCounters(data);
            } else if (data.action === "reset_all_counters") {
                log("🔄 Full Reset");
                if (data.breakState) {
                    applyBreakState(data.breakState);
                } else {
                    const fallbackMinutes = Number(shiftSchedule?.breakMinutes || getProspectiveShiftPolicy().breakMinutes || 30);
                    const fallbackKind = fallbackMinutes >= 60 ? 'LUNCH' : 'BREAK';
                    breakState = {
                        onBreak:false,
                        totalSeconds:fallbackMinutes * 60,
                        usedSeconds:0,
                        remainingSeconds:fallbackMinutes * 60,
                        available:true,
                        expired:false,
                        allowanceMinutes:fallbackMinutes,
                        kind:fallbackKind,
                        label:fallbackKind === 'LUNCH' ? 'Lunch Break' : 'Break'
                    };
                }
                specialSessionState = {
                    activeType: null,
                    BIO: { totalSecondsPerSession:900, maxSessions:1, currentSession:1, currentRemainingSeconds:900, sessionsRemainingAfterCurrent:0, exhausted:false, active:false },
                    HBIO: { totalSecondsPerSession:600, maxSessions:1, currentSession:1, currentRemainingSeconds:600, sessionsRemainingAfterCurrent:0, exhausted:false, active:false }
                };
                updateBreakControl();
                renderSpecialSessionControls();
                resetLocalCounters(data);
            } else {
                initializeLocalCountersFromStats(data);
                if (data.action) {
                    log("Server: " + data.action);
                }
            }
        } catch (err) {
            console.error('❌ SSE update error:', err);
            reportTrackerClientError('sse.message_parse', err, {
                errorCode: 'ERR-FRONTEND-SSE-MESSAGE',
                severity: 'ERROR',
                endpoint: '/events'
            });
        }
    };
    eventSource.onerror = () => {
        controllerConnected = false;
        renderControllerIdentity();
        renderShiftWall();
        log('Reconnecting...');
        const now = Date.now();
        if (now - lastSseErrorReportAt >= 60000) {
            lastSseErrorReportAt = now;
            reportTrackerClientError('sse.connection', new Error('EventSource disconnected from the local controller.'), {
                errorCode: 'ERR-FRONTEND-SSE-CONNECTION',
                severity: 'WARN',
                endpoint: '/events'
            });
        }
        eventSource.close();
        setTimeout(connectEvents, 3000);
    };

}

