function startShiftFromOverlay() {

    if (!controllerConnected) {
        showTrackerNotice('Controller disconnected. Retry the controller connection before starting shift.', 10000);
        renderShiftWall();
        return;
    }
    const startAt = Date.now();
    const prospective = getProspectiveShiftPolicy(startAt);
    const expectedEnd = new Date(startAt + prospective.regularWindowMinutes * 60 * 1000).toLocaleTimeString('en-US', { timeZone: 'Asia/Manila', hour12: true });
    if (!window.confirm(
        'Start Shift now?\n\nDepartment: ' + prospective.department
        + '\nRegular window: ' + formatShiftMinutes(prospective.regularWindowMinutes)
        + '\nPause allowance: ' + prospective.pauseSummary
        + '\nRegular intervals: ' + prospective.intervalCount
        + '\nExpected regular end: ' + expectedEnd
        + '\n\nOvertime starts after the regular window.'
    )) return;
    api('POST', '/', { action: 'start_shift', browserInfo: getTrackerBrowserInfo() }, data => {
        if (!data || data.error || data.success === false) {
            showTrackerNotice(data?.message || data?.error || 'Unable to start shift.', 10000);
            return;
        }
        updateStats(data);
        resetIdleTimer();
        showTrackerNotice(
            data.clearedPreStartCounters
                ? 'Shift started. Previous pre-start counters were cleared so tasks and timing use the same measurement window.'
                : 'Shift started. Active/Idle timing and report counters are now running.',
            11000
        );
        const schedule = data.shiftSchedule || shiftSchedule;
        showTrackerNotice('Shift started. Regular end: ' + formatTrackerTime(schedule?.regularEndAt) + ' • OT begins: ' + formatTrackerTime(schedule?.overtimeStartsAt), 12000);
        log('Shift tracking started');
        renderShiftWall();
    });

}

function endShiftFromOverlay() {
    if (!shiftStarted) return;
    if (!window.confirm('End Shift now?\n\nAuto Tracker will stop timing and generate/update the final daily report.')) return;
    api('POST', '/', { action: 'end_shift', generateReport: true }, data => {
        if (!data || data.success === false || data.error) {
            showTrackerNotice(data?.message || data?.error || 'Unable to end shift.', 12000);
            return;
        }
        updateStats(data);
        showTrackerNotice(data.report?.drive?.ok === true
            ? 'Shift ended. Final report updated and sent to Drive.'
            : 'Shift ended. Final report was generated; check Drive status if upload is pending.', 14000);
        log('Shift ended');
        renderShiftWall();
    });
}



